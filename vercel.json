{
    "version": 2,
    "builds": [
        {
            "src": "api/index.py",
            "use": "@vercel/python"
        },
        {
            "src": "package.json",
            "use": "@vercel/static-build",
            "config": { "distDir": "." }
        }
    ],
    "routes": [
        { "src": "/api/(.*)", "dest": "/api/index.py" },
        { "src": "/painel", "status": 308, "headers": { "Location": "/painel/" } },
        { "src": "/painel/", "dest": "/painel/index.html" },
        { "src": "/(.*)", "dest": "/$1" }
    ]
}