options:
    # ==============================================================================
    # CONFIGURAÇÃO DA API (MUITO IMPORTANTE)
    # ==============================================================================
    # Se o seu site está na Vercel, coloque: https://nome-do-seu-projeto.vercel.app/api
    # Se o servidor e o site estão no mesmo PC: http://localhost:5000
    # Se o site está em outro PC na mesma rede: http://192.168.x.x:5000
    # ==============================================================================
    simplex_api: http://localhost:5000
    
    simplex_agent: mc-server-01
    
    # Comandos de entrega
    # Use %player% para o nick e %product% para o produto
    cmd_lord: lp user %player% parent set lord
    cmd_knight: lp user %player% parent set knight
    cmd_guardian: lp user %player% parent set guardian
    cmd_champion: lp user %player% parent set champion

on script load:
    if {simplex::api} is not set:
        set {simplex::api} to "{@simplex_api}"
    if {simplex::agent} is not set:
        set {simplex::agent} to "{@simplex_agent}"
    
    send "&a[Simplex] Conector iniciado. API: %{simplex::api}%" to console
    
    if {simplex::token} is not set:
        send "&e[Simplex] Token não encontrado. Iniciando modo de pareamento..." to console
        simplex_start_pairing()
    else:
        send "&a[Simplex] Token encontrado. Conectado como %{simplex::agent}%" to console

function simplex_generate_code() :: text:
    set {_chars} to "ABCDEF0123456789"
    set {_code} to ""
    loop 6 times:
        set {_r} to random integer between 1 and 16
        set {_c} to subtext of {_chars} from {_r} to {_r}
        set {_code} to "%{_code}%%{_c}%"
    return {_code}

function simplex_start_pairing():
    set {simplex::pairing_active} to true
    set {_code} to simplex_generate_code()
    set {simplex::pairing_code} to {_code}
    
    # Registra o código no backend
    set {_url} to "%{simplex::api}%/connector/setup/init"
    # Skript escape: use double double quotes for literal quotes inside string
    set {_body} to "{""code"":""%{_code}%"",""agent"":""%{simplex::agent}%""}"
    set {_headers::*} to "Content-Type:application/json"
    
    # Removido try/catch (não suportado nativamente em algumas versões)
    set {_response} to request {_url} with method "POST" and headers {_headers::*} and body {_body}
    set {_status} to response status of {_response}
    
    if {_status} is not 200:
        send "&c[Simplex] Erro ao registrar código de pareamento. Status: %{_status}%" to console
        send "&c[Simplex] Verifique se o endereço da API em 'options' está correto e acessível pelo servidor." to console
    
    send "&e[Simplex] =========================================" to console
    send "&e[Simplex] PAREAMENTO NECESSÁRIO" to console
    send "&e[Simplex] Código: &b%{_code}%" to console
    send "&e[Simplex] Insira este código no Painel Admin > Configurações" to console
    send "&e[Simplex] =========================================" to console

every 5 seconds:
    if {simplex::pairing_active} is true:
        if {simplex::token} is set:
            delete {simplex::pairing_active}
            stop
            
        set {_code} to {simplex::pairing_code}
        set {_url} to "%{simplex::api}%/connector/setup/poll?code=%{_code}%"
        
        # Request simples sem try/catch
        set {_response} to request {_url} with method "GET"
        set {_status} to response status of {_response}
        
        if {_status} is 200:
            set {_content} to response content of {_response}
            
            if {_content} contains "CLAIMED":
                # JSON: {"status": "CLAIMED", "token": "..."}
                set {_parts::*} to {_content} split at "token"
                set {_token_part} to {_parts::2}
                # Limpa caracteres JSON
                replace all ":" and """" and "}" and " " and "{" and "]" in {_token_part} with ""
                set {simplex::token} to {_token_part}
                
                send "&a[Simplex] =========================================" to console
                send "&a[Simplex] PAREAMENTO CONCLUÍDO!" to console
                send "&a[Simplex] Token salvo com sucesso." to console
                send "&a[Simplex] =========================================" to console
                
                delete {simplex::pairing_active}
                delete {simplex::pairing_code}
            else:
                # Anuncia a cada ~30s (1 em 6 loops)
                if {simplex::announce_tick} is not set:
                    set {simplex::announce_tick} to 0
                add 1 to {simplex::announce_tick}
                if {simplex::announce_tick} >= 6:
                    set {simplex::announce_tick} to 0
                    send "&e[Simplex] Aguardando pareamento... Código: &b%{_code}%" to console
        else:
            # Silencioso para não spammar o console se backend estiver off
            # send "&c[Simplex] Falha no polling (%{_status}%)." to console
            stop

function simplex_request(method: text, endpoint: text, body: text = "") :: text:
    if {simplex::token} is not set:
        return "ERROR"
    
    set {_url} to "%{simplex::api}%%{_endpoint}%"
    set {_headers::*} to "Content-Type:application/json" and "Authorization:Bearer %{simplex::token}%"
    
    if {_method} is "GET":
        set {_response} to request {_url} with method "GET" and headers {_headers::*}
    else:
        set {_response} to request {_url} with method {_method} and headers {_headers::*} and body {_body}
        
    set {_status} to response status of {_response}
    
    if {_status} is 401:
        send "&c[Simplex] Token inválido ou expirado. Reinicie o pareamento deletando {simplex::token}." to console
        return "ERROR"
    
    if {_status} is 200:
        return response content of {_response}
        
    return "ERROR"

function simplex_confirm_delivery(id: text):
    set {_body} to "{""id"":""%{_id}%""}"
    set {_res} to simplex_request("POST", "/connector/deliveries/confirm", {_body})
    if {_res} is not "ERROR":
        send "&a[Simplex] Entrega confirmada para ID %{_id}%" to console

function simplex_execute_cmd(cmd: text, player: text):
    set {_final_cmd} to {_cmd}
    replace all "%%player%%" in {_final_cmd} with {_player}
    execute console command {_final_cmd}

every 30 seconds:
    if {simplex::token} is set:
        # Heartbeat
        set {_hb_body} to "{""type"":""heartbeat"",""payload"":{""agent"":""%{simplex::agent}%"",""online"":%number of all players%}}"
        simplex_request("POST", "/connector/events", {_hb_body})
        
        # Check deliveries
        set {_res} to simplex_request("GET", "/connector/deliveries")
        if {_res} is not "ERROR":
            if {_res} contains "id":
                send "&a[Simplex] Novas entregas detectadas: %{_res}%" to console
                
                set {_parts::*} to {_res} split at "id"
                loop {_parts::*}:
                    if loop-value contains "customer_name":
                        set {_entry} to loop-value
                        
                        # Extrair ID
                        set {_id_raw} to subtext of {_entry} from 4 to 20
                        set {_id_parts::*} to {_id_raw} split at """"
                        set {_id} to {_id_parts::1}
                        
                        # Extrair Nick
                        set {_nick_parts::*} to {_entry} split at "customer_name"
                        set {_nick_raw} to {_nick_parts::2}
                        replace all ":" and """" and " " in {_nick_raw} with ""
                        set {_nick_clean_parts::*} to {_nick_raw} split at ","
                        set {_nick} to {_nick_clean_parts::1}
                        
                        # Extrair Produto
                        set {_prod_parts::*} to {_entry} split at "product"
                        set {_prod_raw} to {_prod_parts::2}
                        replace all ":" and """" and " " and "}" and "]" in {_prod_raw} with ""
                        set {_product} to {_prod_raw}
                        
                        send "&a[Simplex] Processando entrega: %{_product}% para %{_nick}% (ID: %{_id}%)" to console
                        
                        # Executar comando (Corrigido contexto de player)
                        if {_product} is "LORD":
                            set {_cmd} to "{@cmd_lord}"
                            replace all "%%player%%" in {_cmd} with {_nick}
                            execute console command {_cmd}
                        else if {_product} is "KNIGHT":
                            set {_cmd} to "{@cmd_knight}"
                            replace all "%%player%%" in {_cmd} with {_nick}
                            execute console command {_cmd}
                        else if {_product} is "GUARDIAN":
                            set {_cmd} to "{@cmd_guardian}"
                            replace all "%%player%%" in {_cmd} with {_nick}
                            execute console command {_cmd}
                        else if {_product} is "CHAMPION":
                            set {_cmd} to "{@cmd_champion}"
                            replace all "%%player%%" in {_cmd} with {_nick}
                            execute console command {_cmd}
                            
                        # Confirmar
                        simplex_confirm_delivery({_id})
